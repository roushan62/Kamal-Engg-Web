# Kamal Engineering contact form configuration
# Add these variables in Vercel: Project Settings > Environment Variables

# Email where website enquiries should arrive.
CONTACT_TO_EMAIL=sales.kamalengg01@gmail.com

# Recommended free email backend: https://web3forms.com
# Create a free access key for CONTACT_TO_EMAIL and paste it here.
WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key

# Optional alternatives. Keep commented unless you use these services.
# RESEND_API_KEY=replace_with_your_resend_api_key
# CONTACT_FROM_EMAIL=Kamal Engineering <onboarding@resend.dev>
# FORMSPREE_FORM_ID=replace_with_your_formspree_form_id
# FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
